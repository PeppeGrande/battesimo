<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Il mio battesimo — Ginevra</title>
<link rel="icon" href="data:,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Italianno&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
/* ============================================================
   PALETTE — campionata direttamente dai fotogrammi del video
   ============================================================ */
:root{
  --crema:#F4F1EA;
  --marrone:#7A5236;
  --marrone-scuro:#5E3D27;
  --oro:#C9A24D;
  --inchiostro:#4A4038;
  --grigio:#8D8479;
  --nero:#0B0B0D;

  --serif:"Cormorant Garamond",Garamond,"Times New Roman",serif;
  --script:"Italianno",cursive;
  --sans:"Jost",-apple-system,"Segoe UI",sans-serif;

  /* MOVIMENTO DELLA BUSTA (misurato sul video).
     Per togliere OGNI movimento, metti tutti e quattro cosi':
       --mov-scala:1;  --mov-salita:0%;
       --mov-scala-fine:1;  --mov-salita-fine:0%;
     Per dimezzarlo: --mov-scala:1.025; --mov-salita:-3%;
                     --mov-scala-fine:1.04; --mov-salita-fine:-3.6%;  */
  --mov-scala:1.05;
  --mov-salita:-6.07%;
  --mov-scala-fine:1.08;
  --mov-salita-fine:-7.2%;
  --t-zoom:2050ms;
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{
  background:var(--crema);
  color:var(--inchiostro);
  font-family:var(--serif);
  overflow-x:hidden;
}
body.bloccato{overflow:hidden;height:100vh}
img{display:block;max-width:100%}

/* ============================================================
   1. SIPARIO — LA BUSTA CON IL SIGILLO DI CERALACCA
   ============================================================ */
#busta{
  position:fixed; inset:0; z-index:100;
  overflow:hidden; cursor:pointer;
  background:#EFEAE0;
  -webkit-tap-highlight-color:transparent;
}
#busta-img{
  position:absolute; inset:0;
  background:url('assets/busta-sigillo.jpg') center/cover no-repeat;
  transform-origin:50% 50%;
  will-change:transform,filter;
}
#tocca{
  position:absolute; left:0; right:0; bottom:19%;
  text-align:center;
  font-family:var(--sans); font-weight:300;
  font-size:clamp(10px,2.9vw,13px);
  letter-spacing:.34em; text-transform:uppercase;
  color:#6E6357;
  animation:respiro 2.8s ease-in-out infinite;
}
@keyframes respiro{0%,100%{opacity:.25}50%{opacity:1}}

/* il tap avvia lo zoom lento verso il sigillo */
#busta.apre #busta-img{
  animation:zoomSigillo var(--t-zoom) cubic-bezier(.55,.05,.8,.35) forwards;
}
@keyframes zoomSigillo{
  /* Misurato sul video: il sigillo NON si ingrandisce quasi (1 -> 1.07),
     l'inquadratura sale di circa il 6% dell'altezza. Il movimento accelera
     verso la fine, quindi ease-in. */
  0%   {transform:scale(1)    translateY(0);
        filter:brightness(1) saturate(1)}
  86%  {transform:scale(var(--mov-scala)) translateY(var(--mov-salita));
        filter:brightness(1.02) saturate(.99);
        animation-timing-function:linear}
  /* ultimo tratto: prosegue appena mentre la luce invade tutto */
  100% {transform:scale(var(--mov-scala-fine)) translateY(var(--mov-salita-fine));
        filter:brightness(1.26) saturate(.66) blur(2px)}
}
#busta.apre #tocca{animation:none; opacity:0; transition:opacity .25s}
#busta.via{opacity:0; pointer-events:none; transition:opacity .35s linear}

/* ============================================================
   2. HERO
   ============================================================ */
.hero{
  position:relative; z-index:0;
  height:100svh; min-height:560px;
  display:flex; align-items:center; justify-content:center;
  overflow:hidden; background:var(--nero);
}
.slide{
  position:absolute; inset:0; z-index:1;
  background-position:center; background-size:cover;
  opacity:0; transition:opacity 2.2s ease-in-out;
  animation:kenburns 22s ease-in-out infinite alternate;
}
.slide.on{opacity:1}
@keyframes kenburns{from{transform:scale(1.02)}to{transform:scale(1.16)}}

/* SEGNAPOSTO — sostituisci ogni riga con: background-image:url('assets/hero-1.jpg') */
.slide:nth-child(1){background-image:linear-gradient(180deg,#12213D 0%,#2C3556 42%,#6B4A63 72%,#C08A7E 100%)}
.slide:nth-child(2){background-image:linear-gradient(180deg,#1B2A4A 0%,#4A3A5C 55%,#B98A85 100%)}
.slide:nth-child(3){background-image:linear-gradient(160deg,#2A3B57 0%,#7A6A78 60%,#E6C3B8 100%)}
.slide:nth-child(4){background-image:linear-gradient(200deg,#101C33 0%,#3E3A5E 50%,#A8837F 100%)}

.velo{
  position:absolute; inset:0; z-index:2;
  background:
    radial-gradient(120% 80% at 50% 42%, rgba(0,0,0,.14) 0%, rgba(0,0,0,.42) 62%, rgba(0,0,0,.62) 100%),
    linear-gradient(180deg, rgba(10,12,22,.35) 0%, rgba(10,12,22,.05) 45%, rgba(10,12,22,.45) 100%);
}
/* lo schermo che copre l'hero durante l'apertura: crema -> nero -> trasparente */
#flash{
  position:absolute; inset:0; z-index:3;
  background:#F2EEE6; opacity:0; pointer-events:none;
}
.hero-testo{
  position:relative; z-index:4;
  text-align:center; color:#fff;
  padding:0 24px; margin-top:-4vh;
  opacity:0;
}
.hero-testo.visibile{opacity:1; transition:opacity .9s ease-out}
.nome{
  font-family:var(--script); font-weight:400;
  font-size:clamp(74px,20vw,132px); line-height:.92;
  text-shadow:0 2px 26px rgba(0,0,0,.5), 0 0 60px rgba(0,0,0,.35);
}
.divisore{
  display:flex; align-items:center; justify-content:center; gap:18px;
  margin:6px auto 22px; max-width:330px;
}
.divisore i{
  flex:1; height:1px;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.75));
}
.divisore i:last-child{background:linear-gradient(270deg,transparent,rgba(255,255,255,.75))}
.calice{
  width:clamp(38px,10vw,52px); height:auto; flex:none;
  filter:drop-shadow(0 0 12px rgba(235,196,110,.65));
}
.occasione{
  font-style:italic; font-weight:300;
  font-size:clamp(28px,7.4vw,42px); line-height:1.15;
  text-shadow:0 2px 18px rgba(0,0,0,.55);
}
.data{
  font-weight:400;
  font-size:clamp(15px,4vw,20px); letter-spacing:.06em;
  margin-top:8px; opacity:.94;
  text-shadow:0 2px 14px rgba(0,0,0,.55);
}
.scroll-ind{
  position:absolute; left:50%; bottom:9%; z-index:4;
  transform:translateX(-50%);
  width:26px; height:42px; border-radius:14px;
  border:1.5px solid rgba(255,255,255,.72);
  background:rgba(255,255,255,.12);
  opacity:0; transition:opacity 1s ease 1.2s;
}
.scroll-ind.visibile{opacity:1}
.scroll-ind::after{
  content:""; position:absolute; left:50%; top:9px;
  width:4px; height:8px; border-radius:2px; background:#fff;
  transform:translateX(-50%);
  animation:rotella 1.9s ease-in-out infinite;
}
@keyframes rotella{
  0%{opacity:0; transform:translate(-50%,-4px)}
  35%{opacity:1}
  100%{opacity:0; transform:translate(-50%,16px)}
}

/* ============================================================
   3. SEZIONI
   ============================================================ */
main{background:var(--crema)}
section{padding:74px 22px}
.titolo{
  font-weight:400;
  font-size:clamp(28px,7.4vw,36px); text-align:center;
  color:var(--inchiostro);
}
.sotto{
  font-family:var(--sans); font-weight:300;
  font-size:13px; text-align:center;
  color:var(--grigio); margin-top:8px;
}
.fiocco{
  display:block; margin:0 auto 18px;
  width:34px; height:auto;
  filter:drop-shadow(0 0 8px rgba(201,162,77,.35));
}

/* conto alla rovescia */
.griglia-cd{
  display:grid; grid-template-columns:1fr 1fr; gap:14px;
  max-width:420px; margin:30px auto 0;
}
.cella{
  background:#fff; border:1px solid #E6E0D3; border-radius:10px;
  padding:20px 8px 14px; text-align:center;
  box-shadow:0 1px 2px rgba(74,64,56,.04);
}
.cella b{
  display:block; font-weight:400;
  font-size:38px; line-height:1; color:var(--inchiostro);
  font-variant-numeric:tabular-nums;
}
.cella span{
  display:block; margin-top:9px;
  font-family:var(--sans); font-weight:300; font-size:10px;
  letter-spacing:.22em; text-transform:uppercase; color:var(--grigio);
}
.separatore{
  display:flex; align-items:center; justify-content:center; gap:14px;
  max-width:280px; margin:56px auto 0;
}
.separatore i{flex:1; height:1px; background:#DCD5C6}
.separatore em{color:var(--oro); font-size:13px; font-style:normal}

/* dettagli del giorno */
.card{
  background:#FBF9F5; border-radius:14px;
  padding:30px 20px 22px; text-align:center;
  max-width:460px; margin:0 auto 20px;
  box-shadow:0 1px 3px rgba(74,64,56,.05);
}
.pallino{
  width:52px; height:52px; margin:0 auto 18px;
  border-radius:50%; background:var(--marrone);
  display:flex; align-items:center; justify-content:center;
}
.pallino svg{width:24px; height:24px; fill:none; stroke:#fff; stroke-width:1.7}
.card h3{
  font-weight:400;
  font-size:clamp(21px,5.6vw,26px); color:var(--inchiostro);
}
.orario{
  display:flex; align-items:center; justify-content:center; gap:7px;
  margin-top:7px;
  font-family:var(--sans); font-weight:300; font-size:14px; color:var(--grigio);
}
.orario svg{width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.6}
.foto{
  margin:20px 0; border-radius:10px; overflow:hidden;
  aspect-ratio:16/10; background:#E8E2D6;
  display:flex; align-items:center; justify-content:center;
  font-family:var(--sans); font-size:12px; letter-spacing:.16em;
  text-transform:uppercase; color:#A79E90;
}
.foto img{width:100%; height:100%; object-fit:cover}
.bottone{
  display:block; width:100%;
  background:var(--marrone); color:#fff; text-decoration:none;
  font-family:var(--sans); font-weight:400; font-size:15px;
  text-align:center;
  padding:16px; border-radius:9px;
  transition:background .25s;
}
.bottone:active{background:var(--marrone-scuro)}

/* chiusura */
.chiusura{padding:64px 22px 96px; text-align:center; background:var(--crema)}
.chiusura h2{font-weight:400; font-size:clamp(26px,7vw,34px)}
.chiusura p{
  font-family:var(--sans); font-weight:300; font-size:11px;
  letter-spacing:.24em; text-transform:uppercase;
  color:var(--grigio); margin-top:22px;
}
.firma{
  font-style:italic; font-weight:400;
  font-size:clamp(19px,5.2vw,23px); color:var(--marrone); margin-top:8px;
}

/* comparsa allo scroll */
.rivela{opacity:0; transform:translateY(26px); transition:opacity .9s ease-out, transform .9s ease-out}
.rivela.dentro{opacity:1; transform:none}

/* ============================================================
   4. PULSANTE AUDIO
   ============================================================ */
#audio-btn{
  position:fixed; right:18px; bottom:18px; z-index:60;
  width:54px; height:54px; border:none; border-radius:50%;
  background:rgba(122,82,54,.9); cursor:pointer;
  display:none; align-items:center; justify-content:center;
  box-shadow:0 4px 16px rgba(0,0,0,.22);
  -webkit-tap-highlight-color:transparent;
}
#audio-btn.pronto{display:flex}
#audio-btn svg{width:24px; height:24px; fill:#fff}
#audio-btn .muto{display:none}
#audio-btn.silenzioso .suono{display:none}
#audio-btn.silenzioso .muto{display:block}

@media (prefers-reduced-motion:reduce){
  .slide,.rivela,.hero-testo{animation:none!important; transition:none!important}
}
</style>
</head>
<body class="bloccato">

<!-- ══════════ 1. LA BUSTA ══════════ -->
<div id="busta" role="button" tabindex="0" aria-label="Tocca per aprire l'invito">
  <div id="busta-img"></div>
  <p id="tocca">Tocca per aprire</p>
</div>

<!-- ══════════ 2. IL SITO ══════════ -->
<main>
  <section class="hero">
    <div class="slide on"></div>
    <div class="slide"></div>
    <div class="slide"></div>
    <div class="slide"></div>
    <div class="velo"></div>
    <div id="flash"></div>

    <div class="hero-testo" id="hero-testo">
      <!-- ⬇ NOME DELLA BAMBINA -->
      <h1 class="nome">Ginevra</h1>
      <div class="divisore">
        <i></i>
        <svg class="calice" viewBox="0 0 64 64" aria-hidden="true">
          <defs>
            <linearGradient id="oro" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0"   stop-color="#FBEEC0"/>
              <stop offset=".38" stop-color="#DDB763"/>
              <stop offset=".68" stop-color="#B98F3C"/>
              <stop offset="1"   stop-color="#F2DC9E"/>
            </linearGradient>
          </defs>
          <path fill="url(#oro)" d="M13 8h38c0 15.6-8 24.4-16 26.6V46h9.4c1.8 0 3.1 1.2 3.1 2.7S46.2 51.4 44.4 51.4H19.6c-1.8 0-3.1-1.2-3.1-2.7S17.8 46 19.6 46H29V34.6C21 32.4 13 23.6 13 8z"/>
          <path fill="rgba(255,255,255,.4)" d="M18 11h5c0 9.4 2.2 15.8 5.2 19.2C22.4 27.4 18 20 18 11z"/>
        </svg>
        <i></i>
      </div>
      <!-- ⬇ OCCASIONE E DATA -->
      <p class="occasione">Il mio battesimo</p>
      <p class="data">12 Aprile 2026</p>
    </div>

    <div class="scroll-ind" id="scroll-ind"></div>
  </section>

  <!-- ── CONTO ALLA ROVESCIA ── -->
  <section class="rivela">
    <h2 class="titolo">Conto alla rovescia</h2>
    <p class="sotto">Per il nostro giorno speciale</p>
    <div class="griglia-cd" id="griglia-cd">
      <div class="cella"><b id="cd-g">—</b><span>giorni</span></div>
      <div class="cella"><b id="cd-o">—</b><span>ore</span></div>
      <div class="cella"><b id="cd-m">—</b><span>minuti</span></div>
      <div class="cella"><b id="cd-s">—</b><span>secondi</span></div>
    </div>
    <div class="separatore"><i></i><em>&#10038;</em><i></i></div>
  </section>

  <!-- ── DETTAGLI DEL GIORNO ── -->
  <section class="rivela" style="padding-top:36px">
    <svg class="fiocco" viewBox="0 0 64 64" aria-hidden="true">
      <path fill="url(#oro)" d="M13 8h38c0 15.6-8 24.4-16 26.6V46h9.4c1.8 0 3.1 1.2 3.1 2.7S46.2 51.4 44.4 51.4H19.6c-1.8 0-3.1-1.2-3.1-2.7S17.8 46 19.6 46H29V34.6C21 32.4 13 23.6 13 8z"/>
    </svg>
    <h2 class="titolo">Dettagli del giorno</h2>
    <p class="sotto">Tutto quello che devi sapere</p>

    <div class="card" style="margin-top:34px">
      <div class="pallino">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M8 8h8M5 21h14M7 21V11l5-4 5 4v10"/></svg>
      </div>
      <!-- ⬇ LUOGO DELLA CERIMONIA -->
      <h3>Parrocchia di Sant'Ambrogio V.</h3>
      <p class="orario">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        Alle ore 16:00
      </p>
      <div class="foto"><!-- <img src="assets/chiesa.jpg" alt="La chiesa"> -->foto della chiesa</div>
      <a class="bottone" target="_blank" rel="noopener"
         href="https://www.google.com/maps/search/?api=1&amp;query=Parrocchia+di+Sant+Ambrogio">Apri in Maps</a>
    </div>

    <div class="card">
      <div class="pallino">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
      </div>
      <!-- ⬇ LUOGO DEL RICEVIMENTO -->
      <h3>Ristorante Il Capriolo</h3>
      <p class="orario">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        Dalle ore 18:30
      </p>
      <div class="foto"><!-- <img src="assets/ristorante.jpg" alt="Il ristorante"> -->foto del ristorante</div>
      <a class="bottone" target="_blank" rel="noopener"
         href="https://www.google.com/maps/search/?api=1&amp;query=Ristorante+Il+Capriolo">Apri in Maps</a>
    </div>
  </section>

  <!-- ── CHIUSURA ── -->
  <div class="chiusura rivela">
    <h2>Vi aspettiamo!</h2>
    <p>Con amore</p>
    <!-- ⬇ FIRMA -->
    <div class="firma">Mamma &amp; Papà di Ginevra</div>
  </div>
</main>

<button id="audio-btn" aria-label="Attiva o disattiva la musica">
  <svg class="suono" viewBox="0 0 24 24"><path d="M4 9v6h3.5L12 19V5L7.5 9H4zm11.5-.6a4.2 4.2 0 0 1 0 7.2v-1.9a2.4 2.4 0 0 0 0-3.4V8.4zm0-3.4a7.6 7.6 0 0 1 0 14v-1.8a5.8 5.8 0 0 0 0-10.4V5z"/></svg>
  <svg class="muto" viewBox="0 0 24 24"><path d="M4 9v6h3.5L12 19V5L7.5 9H4zm14.9 3 2.4-2.4-1.3-1.3L17.6 10.7l-2.4-2.4-1.3 1.3 2.4 2.4-2.4 2.4 1.3 1.3 2.4-2.4 2.4 2.4 1.3-1.3L18.9 12z"/></svg>
</button>

<audio id="bgm" loop preload="auto" src="assets/musica.m4a"></audio>

<script>
/* ════════════════════════════════════════════════════════════
   DATA E ORA DELL'EVENTO — anno, mese (0=gennaio!), giorno, ora, minuti
   Es. 12 aprile 2026 alle 16:00  ->  (2026, 3, 12, 16, 0)
   ════════════════════════════════════════════════════════════ */
const EVENTO = new Date(2026, 3, 12, 16, 0, 0);

/* ---------- 1. APERTURA DELLA BUSTA ---------- */
const busta    = document.getElementById('busta');
const flash    = document.getElementById('flash');
const heroTxt  = document.getElementById('hero-testo');
const indica   = document.getElementById('scroll-ind');
const bgm      = document.getElementById('bgm');
const btnAudio = document.getElementById('audio-btn');

let aperto = false;

function apri(){
  if(aperto) return;
  aperto = true;

  busta.classList.add('apre');          // avvia il movimento della busta

  /* Tempi rilevati sul video, contati dall'istante del tap:
       1800 ms  la luce comincia a invadere lo schermo
       2150 ms  bianco pieno
       2200 ms  i nomi affiorano sul crema
       2650 ms  il crema e' diventato nero
       2900 ms  il nero si dissolve e appare l'immagine
       4300 ms  hero completa                                  */

  // 1800 ms - dissolvenza al crema (nel video e' rapida: 330 ms)
  setTimeout(function(){
    flash.style.transition = 'opacity 330ms ease-in';
    flash.style.opacity = '1';
  }, 1700);

  // 2130 ms - schermo pieno: la busta esce di scena
  setTimeout(function(){
    busta.classList.add('via');
    document.body.classList.remove('bloccato');
  }, 2050);

  // 2200 ms - i nomi affiorano appena, ancora sul crema
  setTimeout(function(){ heroTxt.classList.add('visibile'); }, 2120);

  // 2300 ms - il crema sfuma nel nero e la scritta prende corpo
  setTimeout(function(){
    flash.style.transition = 'background-color 350ms ease-in-out';
    flash.style.backgroundColor = '#0B0B0D';
  }, 2220);

  // 2900 ms - il nero si dissolve: appare l'immagine
  setTimeout(function(){
    flash.style.transition = 'opacity 1400ms ease-out';
    flash.style.opacity = '0';
    indica.classList.add('visibile');
  }, 2820);

  setTimeout(function(){ busta.remove(); }, 2520);

  /* La musica va per ultima e protetta: se il browser la blocca
     (accade aprendo il file in locale) l'apertura deve proseguire comunque. */
  try { avviaMusica(); } catch(e){ btnAudio.classList.add('pronto','silenzioso'); }
}

busta.addEventListener('click', apri);
busta.addEventListener('keydown', function(e){
  if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); apri(); }
});

/* ---------- 2. MUSICA ---------- */
function avviaMusica(){
  bgm.volume = 0.55;
  var p = bgm.play();
  if(p && typeof p.then === 'function'){
    p.then(function(){
      btnAudio.classList.add('pronto');
      btnAudio.classList.remove('silenzioso');
    }).catch(function(){
      btnAudio.classList.add('pronto','silenzioso');
    });
  } else {
    btnAudio.classList.add('pronto');   // browser che non restituiscono una Promise
  }
}
btnAudio.addEventListener('click', function(){
  if(bgm.paused){
    try {
      var p = bgm.play();
      if(p && p.catch) p.catch(function(){});
    } catch(e){}
    btnAudio.classList.remove('silenzioso');
  }
  else{ bgm.pause(); btnAudio.classList.add('silenzioso'); }
});

/* ---------- 3. CAROSELLO DELL'HERO ---------- */
const slides = document.querySelectorAll('.slide');
let i = 0;
setInterval(function(){
  slides[i].classList.remove('on');
  i = (i + 1) % slides.length;
  slides[i].classList.add('on');
}, 5200);

/* ---------- 4. CONTO ALLA ROVESCIA ---------- */
function due(n){ return String(n).padStart(2,'0'); }
function tic(){
  const d = EVENTO - new Date();
  if(d <= 0){
    document.getElementById('griglia-cd').innerHTML =
      '<div class="cella" style="grid-column:1/-1"><b>&#10038;</b><span>&egrave; il nostro giorno</span></div>';
    return;
  }
  const s = Math.floor(d/1000);
  document.getElementById('cd-g').textContent = Math.floor(s/86400);
  document.getElementById('cd-o').textContent = due(Math.floor(s/3600)%24);
  document.getElementById('cd-m').textContent = due(Math.floor(s/60)%60);
  document.getElementById('cd-s').textContent = due(s%60);
  setTimeout(tic, 1000);
}
tic();

/* ---------- 5. COMPARSA DELLE SEZIONI ---------- */
const oss = new IntersectionObserver(function(es){
  es.forEach(function(e){
    if(e.isIntersecting){ e.target.classList.add('dentro'); oss.unobserve(e.target); }
  });
}, {threshold:.14});
document.querySelectorAll('.rivela').forEach(function(el){ oss.observe(el); });
</script>
</body>
</html>
